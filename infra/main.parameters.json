{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "spaClientId": { "value": "${SPA_CLIENT_ID}" },
    "apiAudience": { "value": "${API_AUDIENCE}" },
    "apiScope": { "value": "${API_SCOPE=access_as_user}" },
    "passkeyAuthContextId": { "value": "${PASSKEY_AUTH_CONTEXT_ID=}" },
    "openAiLocation": { "value": "${AZURE_OPENAI_LOCATION=}" },
    "deploymentMiniName": { "value": "${AZURE_OPENAI_DEPLOYMENT_MINI=gpt-5.4-mini}" },
    "deploymentFullName": { "value": "${AZURE_OPENAI_DEPLOYMENT_FULL=gpt-5.4}" },
    "modelMiniName": { "value": "${AZURE_OPENAI_MODEL_MINI=gpt-4o-mini}" },
    "modelFullName": { "value": "${AZURE_OPENAI_MODEL_FULL=gpt-4o}" },
    "speechLocation": { "value": "${AZURE_SPEECH_LOCATION=}" }
  }
}
