# Local FastAPI development settings.
# Copy this file to `.env` and replace placeholders with your Azure resource values.

TENANT_ID=00000000-0000-0000-0000-000000000000
API_AUDIENCE=api://00000000-0000-0000-0000-000000000000
API_SCOPE=access_as_user

AZURE_OPENAI_ENDPOINT=https://<aoai-name>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-5.4-mini
AZURE_OPENAI_DEPLOYMENT_FULL=gpt-5.5

SPEECH_REGION=japaneast
SPEECH_ENDPOINT=https://japaneast.api.cognitive.microsoft.com
SPEECH_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<speech-name>

TRANSLATOR_ENDPOINT=https://<translator-name>.cognitiveservices.azure.com/translator/text/v3.0
TRANSLATOR_REGION=japaneast

COSMOS_ENDPOINT=https://<cosmos-name>.documents.azure.com:443/
COSMOS_DATABASE=mt
COSMOS_CONTAINER=items

CORS_ALLOWED_ORIGINS=http://localhost:5173
