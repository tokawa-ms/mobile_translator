# azd deployment values.
# Copy values into azd with `azd env set ...`; do not commit real `.env` files.

AZURE_LOCATION=japaneast
AZURE_OPENAI_LOCATION=eastus2
AZURE_SPEECH_LOCATION=japaneast

# Microsoft Entra ID App Registrations
SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000
API_AUDIENCE=api://00000000-0000-0000-0000-000000000000
API_SCOPE=access_as_user

# Optional: Entra Authentication Context ID (example: c1) to prefer passkey-capable flow on mobile.
PASSKEY_AUTH_CONTEXT_ID=

# Optional: override Azure OpenAI deployment names.
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-5.4-mini
AZURE_OPENAI_DEPLOYMENT_FULL=gpt-5.4

# Optional: override Azure OpenAI model names used by each deployment.
# Set these to models available in your Azure OpenAI region and subscription.
AZURE_OPENAI_MODEL_MINI=gpt-4o-mini
AZURE_OPENAI_MODEL_FULL=gpt-4o
